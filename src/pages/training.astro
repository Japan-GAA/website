---
import Photo from "../components/Photo.astro";
import { PHOTOS } from "../config/photos.js";
import Sessions from "../components/Sessions.astro";
import Base from "../layouts/Base.astro";
const MAP = "https://maps.app.goo.gl/DLmB27aQEgWyWzAp7";
---
<Base lang="en" pageKey="training"
  title="Training — Japan GAA | Gaelic Football in Tokyo"
  description="Japan GAA trains at Yashio Kita Park in Shinagawa, Tokyo. Beginners welcome, no experience needed, and your first session is free.">

  <div class="wrap">
    <div class="trainhead">
      <header class="pagehead">
      <h1>Training</h1>
      <p class="hero__lede">
        Your first session is free, and beginners are welcome. Most of our players
        had never seen a Gaelic ball before they turned up. You don't need
        experience, and you don't need to know the rules.
      </p>
    </header>
      <aside class="nextup">
        <h2>Next sessions</h2>
        <Sessions lang="en" />
        <p class="muted">
          The day of the week changes, so
          check here or on <a href="https://www.instagram.com/japangaa" target="_blank" rel="noopener">Instagram</a>.
        </p>
      </aside>
    </div>

    <Photo src={PHOTOS.training} alt="A Japan GAA training session" wide />

    <section class="factgrid">
      <div class="fact">
        <h2>Where</h2>
        <p>
          <strong>Yashio Kita Park</strong><br />
          八潮北公園<br />
          1-3-1 Yashio, Shinagawa-ku, Tokyo 140-0003
        </p>
        <p><a href={MAP} rel="noopener">Open in Google Maps →</a></p>
        <ul class="access">
          <li>14 min walk from <strong>Shinagawa Seaside</strong> (Rinkai Line)</li>
          <li>20 min walk from <strong>Aomono-yokochō</strong> (Keikyū Line)</li>
          <li>10 min by bus from <strong>Shinagawa Station</strong></li>
        </ul>
      </div>

      <div class="fact">
        <h2>What to bring</h2>
        <ul class="bring">
          <li>Sports clothes</li>
          <li>Something to drink. Water is available if you have a bottle</li>
          <li>Football boots, or trainers</li>
          <li>A change of clothes, if you like. There are showers</li>
        </ul>
      </div>
    </section>

    <section class="panel">
      <h2>Membership</h2>
      <p>Fees for 2026:</p>
      <dl class="fees">
        <div><dt>Adult membership</dt><dd>¥15,000</dd></div>
        <div><dt>Student membership</dt><dd>¥7,500</dd></div>
        <div><dt>Per session</dt><dd>¥1,000</dd></div>
      </dl>
      <p>
        Membership covers every training session for the year. We ran around 40
        of them last year. If you'd rather pay as you go, sessions are ¥1,000
        each, and what you pay counts towards the membership fee up to the full
        amount.
      </p>
      <p>
        There's no pressure to work up to full membership. Plenty of people come
        to a handful of sessions a year and pay as they go, and that's completely
        normal.
      </p>
      <p class="callout">
        <strong>Coming for the first time? There's nothing to pay and nothing to
        arrange.</strong> Your first session is free. Just turn up.
      </p>
      <p class="muted">
        When you do join, you can pay by cash on the day, bank transfer, or PayPay.
      </p>
      <p><a class="cta" href="mailto:japangaa@gmail.com">Get in touch</a></p>
    </section>
  </div>
</Base>
