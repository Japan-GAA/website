---
import Cover from "../../../components/Cover.astro";
import Base from "../../../layouts/Base.astro";
import { newsFor, urlFor } from "../../../lib/news";
const posts = await newsFor("ja");

// group by year, newest first
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
const fmt = (d) => d.toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo", month: "long" });
---
<Base lang="ja" pageKey="news" title="ニュース・アーカイブ — Japan GAA"
  description="Japan GAAの活動報告と、2019年からのニュースレター・アーカイブ。大会、練習、イベントの記録と写真。">
  <div class="wrap">
    <header class="pagehead">
      <h1>ニュース</h1>
      <p class="hero__lede">クラブの活動内容と、2019年からのアーカイブです。</p>
    </header>

    {years.map((year) => (
      <section class="archive">
        <h2 class="archive__year">{year}</h2>
        <ul class="newsgrid">
          {posts.filter((p) => p.data.date.getFullYear() === year).map((post) => (
            <li>
              <a href={urlFor(post.id)}>
                <Cover src={post.data.cover} title={post.data.title} />
                <time>{fmt(post.data.date)}</time>
                <h3>{post.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
