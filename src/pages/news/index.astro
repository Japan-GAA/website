---
import Cover from "../../components/Cover.astro";
import Base from "../../layouts/Base.astro";
import { newsFor, urlFor } from "../../lib/news";
const posts = await newsFor("en");

// group by year, newest first
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
const fmt = (d) => d.toLocaleDateString("en-IE", { timeZone: "Asia/Tokyo", month: "long" });
---
<Base lang="en" pageKey="news" title="News and archive — Japan GAA"
  description="Club news from Japan GAA, plus the full newsletter archive going back to 2019 — tournaments, training, socials and photos.">
  <div class="wrap">
    <header class="pagehead">
      <h1>News</h1>
      <p class="hero__lede">Everything happening at the club, and the full archive back to 2019.</p>
    </header>

    {years.map((year) => (
      <section class="archive">
        <h2 class="archive__year">{year}</h2>
        <ul class="newsgrid">
          {posts.filter((p) => p.data.date.getFullYear() === year).map((post) => (
            <li>
              <a href={urlFor(post.id)}>
                <Cover src={post.data.cover} title={post.data.title} />
                <time>{fmt(post.data.date)}</time>
                <h3>{post.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
